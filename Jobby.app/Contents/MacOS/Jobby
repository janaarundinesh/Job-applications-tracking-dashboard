#!/bin/sh
# Jobby — Your Job Applications Tracking Buddy. The app itself.
#
# Opening this starts the tracker if it is not already running, waits until it
# answers, and opens the dashboard. No Terminal window is involved: the server is
# run by the small helper app in Resources, which keeps it alive after this app
# has quit, and writes to data/server.log.
#
# Keep this bundle in the project folder, or dock an alias to it, so that it can
# find server.py and your data. "Start Jobby.command" is still there for the
# terminal-visible case.

set -u

# A double-clicked app starts with a bare environment: no shell profile, a
# minimal PATH and no useful working directory. Add the usual places a real
# python3 hides, and work from the project folder instead.
# Contents/MacOS/Jobby sits three levels inside the project folder.
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../../.." && pwd)
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
export PATH

PORT=8787
URL="http://127.0.0.1:$PORT"
LOG="$ROOT/data/server.log"

alert() {
  osascript -e "display alert \"Jobby\" message \"$1\"" >/dev/null 2>&1
}

cd "$ROOT" 2>/dev/null || {
  alert "The app could not find its folder. Keep Jobby.app in the project folder, or dock an alias to it."
  exit 1
}

if [ ! -f server.py ]; then
  alert "server.py is not next to this app. Keep Jobby.app in the project folder, or dock an alias to it."
  exit 1
fi

PYTHON=$(command -v python3 2>/dev/null)
if [ -z "$PYTHON" ]; then
  alert "Python 3 was not found. Install it from python.org, then open the app again."
  exit 1
fi

is_up() {
  curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1
}

mkdir -p "$ROOT/data"

SOURCE="$HERE/../Resources/JobbyWindow.swift"
WINDOW="$HERE/JobbyWindow"

# The dashboard opens in its own window: a small Swift program built from the
# file in Resources the first time the app opens, and rebuilt only when that
# file changes. So there is still no build step to run and nothing to install —
# and no project file to keep in step.
build_window() {
  if [ -x "$WINDOW" ] && [ ! "$SOURCE" -nt "$WINDOW" ]; then
    return 0
  fi
  # Through xcrun, not a bare path to the compiler: xcrun is what points it at
  # the SDK, and without that it cannot find the standard library.
  if xcrun --find swiftc >/dev/null 2>&1; then
    COMPILER="xcrun swiftc"
  else
    COMPILER=$(command -v swiftc 2>/dev/null) || return 1
  fi
  if ! $COMPILER -O -target "$(uname -m)-apple-macos11.3" -o "$WINDOW.building" "$SOURCE" \
      -framework Cocoa -framework WebKit >>"$LOG" 2>&1; then
    rm -f "$WINDOW.building"
    return 1
  fi
  mv -f "$WINDOW.building" "$WINDOW"
}

# The window, so the dashboard is an app and not a browser tab. If it cannot be
# built on this machine (no Swift toolchain, or a bundle that cannot be written)
# a browser tab is still better than nothing — and a failed exec falls through
# to the browser, so a broken window binary never leaves you with nothing.
show_dashboard() {
  if build_window; then
    exec "$WINDOW" "$URL"
  fi
  open "$URL"
}

# Already running? Then opening the app only has to show the dashboard.
if is_up; then
  show_dashboard
  exit 0
fi

# Compile can build a real PDF with Tectonic. It is optional: fetch it once into
# tools/tectonic, and carry on (in-app preview) if that is not possible.
"$PYTHON" install_tectonic.py --quiet >>"$LOG" 2>&1

# Start the server through the helper app inside Resources, not as a child of
# this bundle. macOS tears an app's processes down when the app quits, and the
# dashboard is allowed to outlive this window — Open in Browser, or a page left
# open while the window is closed. The helper is its own app, so it stops itself
# (and the server) once nothing has asked for anything for two minutes. A nohup
# or a new session does not help here: the teardown follows the app, not its
# process group.
HELPER="$HERE/../Resources/JobbyServer.app"
if ! open -g "$HELPER"; then
  alert "The dashboard's server app could not be opened. The bundle looks incomplete — replace Jobby.app with a fresh copy."
  exit 1
fi

# Wait for it to answer. A cold start still has to open the database, run the
# schema and (the first time) fetch the LaTeX engine.
tries=0
while [ "$tries" -lt 60 ]; do
  if is_up; then
    show_dashboard
    exit 0
  fi
  tries=$((tries + 1))
  sleep 0.25
done

alert "The tracker did not start. The last lines of data/server.log say why — or run python3 server.py in the project folder to see the error for yourself."
exit 1
